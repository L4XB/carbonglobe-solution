+      cg_x_loaded = true;
+      const char* fn = getenv("ED_FIRE_X_FILE");
+      if (fn != NULL) { FILE* fx = fopen(fn, "r"); double v; if (fx != NULL) { while (fscanf(fx, "%lf", &v) == 1) cg_x.push_back(v); fclose(fx); } printf("ED_FIRE_X_FILE %s: %d values\n", fn, (int) cg_x.size()); }
+   }
+   if (!cg_x.empty()) {
+      // the state written for time t already contains the patch dynamics of step t: X[k] acts at step 12 (2 + k)
+      static const long cg_shift = getenv("ED_FIRE_X_SHIFT") ? atol(getenv("ED_FIRE_X_SHIFT")) : 2;   // 1: X[k] acts at the January step of window year k (December-row records)
+      long n = ((long) t - (long) data->start_time) / N_SUB - cg_shift;
+      static const bool cg_cyc = (getenv("ED_FIRE_X_CYCLE") != NULL);     // lookup on cycled weather: the monthly factors cycle with it
+      if (cg_cyc && n >= 0 && cg_x.size() >= 12 * 30) n = n % ((long) cg_x.size() / 12);
+      if (n >= (long) cg_x.size()) n = (long) cg_x.size() - 1;
+      if (cg_x.size() >= 12 * 30) {
+         // MONTHLY factors (12 per window year, wet-month rule already applied): each month contributes at most the cap
+         long ny = (long) cg_x.size() / 12;
+         if (n >= ny) n = ny - 1;
+         fireterm = 0.0;
+         static const bool cg_yearcap = (getenv("ED_FIRE_X_YEARCAP") != NULL);   // shipped structure: mean of the 12 monthly ignitions, THEN the cap
+         if (n >= 0) {
+            for (int m = 0; m < 12; m++) {
+               double r = cp->siteptr->fuel[cp->landuse] * data->fp1 * cg_x[n * 12 + m];
